{
  "name": "cedar-embeddable-designer",
  "description": "A reusable Web Component for designing CEDAR metadata templates.",
  "license": "BSD-2-Clause",
  "version": "0.1.0-dev.20260829.f44c4915",
  "engines": {
    "node": "^24.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metadatacenter/cedar-embeddable-designer.git"
  },
  "bugs": {
    "url": "https://github.com/metadatacenter/cedar-embeddable-designer/issues"
  },
  "homepage": "https://github.com/metadatacenter/cedar-embeddable-designer#readme",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/stage-siblings.mjs",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
    "test:watch": "ng test --watch",
    "test:unit:coverage": "ng test --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "build:app": "ng run cedar-embeddable-designer:build-app",
    "types:public": "tsc -p tsconfig.public-api.json",
    "bundle": "node scripts/make-bundle.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "package:npm": "npm run types:public && node scripts/stage-npm-package.mjs && npm run check:npm-package && npm run check:readme",
    "check:fresh": "node scripts/check-bundle-fresh.mjs",
    "check:npm-package": "node scripts/check-npm-package.mjs",
    "check:readme": "node scripts/check-readme-examples.mjs",
    "dist": "npm run build && npm run bundle && npm run check:size && npm run package:npm",
    "test:boundaries": "node --test scripts/import-boundaries.test.mjs",
    "test:packaging": "node --test scripts/npm-package.test.mjs",
    "test:browser": "npm run dist && npm --prefix browser test",
    "test:browser:prebuilt": "npm run check:fresh && npm --prefix browser test",
    "test:ci": "npm run lint && npm run typecheck && npm test && npm run test:boundaries && npm run test:packaging && npm run dist && npm run test:browser:prebuilt",
    "test:browser:flake-hunt": "npm run check:fresh && for i in $(seq 1 ${RUNS:-20}); do echo \"--- run $i\"; npm --prefix browser test -- --retries=0 --reporter=line || exit 1; done"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/elements": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@tailwindcss/postcss": "^4.3.3",
    "cedar-model-typescript-library": "npm:@org.metadatacenter/cedar-model-typescript-library@^1.0.5-dev.20260827.2030.g9261381c1fb4",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8"
  }
}
