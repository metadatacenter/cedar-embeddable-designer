{
  "name": "cedar-embeddable-designer",
  "description": "A reusable Web Component for designing CEDAR metadata templates.",
  "license": "BSD-2-Clause",
  "version": "0.1.0",
  "engines": {
    "node": "^24.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metadatacenter/cedar-embeddable-designer.git"
  },
  "bugs": {
    "url": "https://github.com/metadatacenter/cedar-embeddable-designer/issues"
  },
  "homepage": "https://github.com/metadatacenter/cedar-embeddable-designer#readme",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
    "test:watch": "ng test --watch",
    "test:unit:coverage": "ng test --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "build:app": "ng run cedar-embeddable-designer:build-app"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/elements": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@tailwindcss/postcss": "^4.3.3",
    "cedar-model-typescript-library": "npm:@org.metadatacenter/cedar-model-typescript-library@^1.0.5-dev.20260827.2030.g9261381c1fb4",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8"
  }
}
